{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "LAB defaults. Secret files are unreadable; commands that change cloud resources or rewrite git history ask first. Read-only queries run without prompts. Rules are text matches, not a security boundary: real protection is the plan / dry-run / rollback workflow in CLAUDE.md and least-privilege credentials. Personal overrides go to .claude/settings.local.json (git-ignored).",
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(/config/lab.json)",
      "Read(/config/*.local.json)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.publishsettings)",
      "Read(**/*.azureProfile)",
      "Read(**/msal_token_cache*)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfvars)",
      "Read(/evidence/**)"
    ],
    "ask": [
      "Bash(az * create *)",
      "Bash(az * delete *)",
      "Bash(az * delete)",
      "Bash(az * update *)",
      "Bash(az * set *)",
      "Bash(az * assign *)",
      "Bash(az role assignment *)",
      "Bash(az deployment * create *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "PowerShell(az * create *)",
      "PowerShell(az * delete *)",
      "PowerShell(az * update *)",
      "PowerShell(az * set *)",
      "PowerShell(az role assignment *)",
      "PowerShell(terraform apply *)",
      "PowerShell(terraform destroy *)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(New-Az*)",
      "PowerShell(Set-Az*)",
      "PowerShell(Update-Az*)",
      "PowerShell(Remove-Az*)",
      "PowerShell(New-Mg*)",
      "PowerShell(Set-Mg*)",
      "PowerShell(Update-Mg*)",
      "PowerShell(Remove-Mg*)",
      "PowerShell(Invoke-MgGraphRequest *)",
      "PowerShell(Set-Mailbox*)",
      "PowerShell(Remove-Mailbox*)",
      "PowerShell(Add-MailboxPermission *)",
      "PowerShell(Remove-MailboxPermission *)",
      "PowerShell(Remove-DistributionGroup*)",
      "PowerShell(Set-TransportRule *)",
      "PowerShell(New-TransportRule *)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)"
    ]
  }
}
